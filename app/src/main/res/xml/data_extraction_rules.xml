<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup and device-to-device transfer for Android 12 and above (API 31+).
  The diagnostic log stays on the device it describes; see backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="rudimentor-log.txt" />
        <exclude domain="file" path="telemetry/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="rudimentor-log.txt" />
        <exclude domain="file" path="telemetry/" />
    </device-transfer>
</data-extraction-rules>
