    <string name="sound_check_permission_grant">Allow the microphone</string>
    <string name="sound_check_pad_title">PAD AND PHONE</string>
    <string name="sound_check_pad_intro">Put the phone next to the pad. Press Start, keep quiet for a moment, then play 8 strokes as you normally would. This teaches the app how loud you are, so the room is not mistaken for your stick.</string>
    <string name="sound_check_pad_ready">Nothing plays in this step.</string>
    <string name="sound_check_pad_silence">Keep quiet for a moment: listening to the room.</string>
    <string name="sound_check_pad_strokes">Now play 8 strokes at your normal loudness (%1$d of %2$d).</string>
    <string name="sound_check_pad_done">Heard you clearly. The phone can tell your strokes from the room.</string>
    <string name="sound_check_pad_noisy">The room is almost as loud as your strokes. It will work, but somewhere quieter works better.</string>
    <string name="sound_check_headphones_title">HEADPHONES</string>
    <string name="sound_check_headphones_intro">Wear the headphones you practise with. A click plays out loud on purpose. Play one stroke on every click, evenly, for about half a minute \u2014 this teaches the app how your headphones behave, so a stroke you played on the click is not judged as late.</string>
    <string name="sound_check_headphones_ready">About half a minute of even strokes.</string>
    <string name="sound_check_headphones_playing">Keep playing one stroke per click (%1$d of %2$d).</string>
    <string name="sound_check_headphones_done">Headphones checked \u2014 saved for \u201c%1$s\u201d. This does not need repeating unless you switch to another pair.</string>
    <string name="sound_check_headphones_stalled">Not one stroke was counted. Check that the phone can hear the pad, or redo the previous step.</string>
    <string name="sound_check_quiet">%1$d strokes were too quiet to count. Play a little harder.</string>
    <string name="sound_check_play_title">FIRST CLICK</string>
    <string name="sound_check_play_intro">Eight strokes with the click, nothing scored, nothing saved. Just to feel what a level feels like.</string>
    <string name="sound_check_play_ready">Press Start when you are ready.</string>
    <string name="sound_check_play_running">One stroke on every click.</string>
    <string name="sound_check_play_done">That is all of it. The levels are open.</string>

    <!-- About -->
    <string name="about_title">ABOUT</string>
    <string name="about_tagline">A practice-pad drum trainer. Rudiments, a metronome and a microphone that listens to your pad \u2014 nothing else.</string>
    <string name="about_version_copied">Version copied.</string>
    <string name="about_feedback_title">FEEDBACK</string>
    <string name="about_feedback_body">Found a bug, or thought of something the app should do? Write to me. Every message goes to one mailbox and is read by the one person who makes this app.</string>
    <string name="about_feedback_button">Send feedback</string>
    <string name="about_feedback_prompt">What happened, or what would you like the app to do?</string>
    <string name="about_no_mail_app">No mail app on this device. The address is copied to the clipboard.</string>
    <string name="about_no_browser">No browser on this device. The link is copied to the clipboard.</string>
    <string name="about_honest_title">THE HONEST BITS</string>
    <string name="about_honest_no_business">No ads, no subscriptions, no accounts, no analytics. The app never talks to a server \u2014 it has no network permission at all.</string>
    <string name="about_honest_mic">The microphone listens in real time to hear your hits. Audio is not recorded, not saved and not sent anywhere.</string>
    <string name="about_honest_on_device">Your progress, settings and practice logs stay on this device. Uninstalling the app deletes them.</string>
    <string name="about_licenses_title">Licenses</string>
    <string name="about_licenses_link">Open source licenses</string>
    <string name="about_care_title">TAKE CARE OF YOURSELF</string>
    <string name="about_care_hearing">A pad plus a metronome in headphones is loud for hours. Keep the volume low enough to hear yourself, and take breaks.</string>
    <string name="about_care_hands">If your hands or wrists hurt, stop. Speed comes from relaxed hands, never from pushing through pain.</string>
